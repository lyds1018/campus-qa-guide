# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=true
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ---- PostgreSQL ----
POSTGRES_DB=campus_qa
POSTGRES_USER=qa
POSTGRES_PASSWORD=change-me-strong-password
DB_HOST=127.0.0.1
DB_PORT=5432

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- MinIO ----
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=qa
MINIO_ROOT_PASSWORD=change-me-min-12-chars
MINIO_BUCKET=campus-qa
# 首次拉取镜像后把实际版本写死在这里，避免 latest 漂移
MINIO_TAG=RELEASE.2024-12-18T13-15-44Z

# ---- 前端 ----
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- 知识入库（P1）----
# 向量维度在建表时决定，换嵌入模型需迁移重建列与索引
EMBEDDING_DIM=1024
CHUNK_SIZE=500
CHUNK_OVERLAP=80
INGEST_QUEUE=queue:ingest
WORKER_STALE_MINUTES=30

# ---- 模型网关（P2）----
GW_CHAT_MAIN_BASE_URL=https://api.deepseek.com/v1
GW_CHAT_MAIN_API_KEY=change-me
GW_CHAT_MAIN_MODEL=deepseek-chat
# 备 chat：留空则不降级，链路只有 main
GW_CHAT_FALLBACK_BASE_URL=
GW_CHAT_FALLBACK_API_KEY=
GW_CHAT_FALLBACK_MODEL=qwen-plus
# 辅助模型（意图分类 / 改写 / 核对）
GW_CHAT_AUX_BASE_URL=
GW_CHAT_AUX_API_KEY=
GW_CHAT_AUX_MODEL=qwen-flash
# embedding：必须产出 EMBEDDING_DIM 维，留空则 embed() 抛 NotConfigured
GW_EMBED_BASE_URL=
GW_EMBED_API_KEY=
GW_EMBED_MODEL=BAAI/bge-m3
GW_EMBED_DOC_PREFIX=
GW_EMBED_QUERY_PREFIX=
# rerank：留空则关闭重排（合法降级，P3 直接用融合分数）
GW_RERANK_BASE_URL=
GW_RERANK_API_KEY=
GW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 可靠性
GW_RETRY_MAX=3
GW_RETRY_INITIAL=0.5
GW_TIMEOUT_CONNECT=3
GW_TIMEOUT_CHAT=60
GW_TIMEOUT_FIRST_TOKEN=20
GW_TIMEOUT_STREAM=120
GW_TIMEOUT_EMBED=30
GW_TIMEOUT_RERANK=20
GW_BREAKER_THRESHOLD=5
GW_BREAKER_WINDOW=60
GW_BREAKER_COOLDOWN=60
GW_BREAKER_RECOVER=2
GW_MAX_CONCURRENCY=8
# 缓存与台账
GW_CACHE_ENABLED=true
GW_CACHE_TTL_CHAT=86400
GW_CACHE_TTL_EMBED=2592000
GW_CACHE_TTL_RERANK=604800
GW_CACHE_TTL_DEGRADED=600
GW_KB_FINGERPRINT_TTL=60
GW_DAILY_BUDGET_CNY=20
GW_BUDGET_HARD_STOP=false
# 故障注入总开关，生产必须 false
GW_FAULT_INJECTION=false

# ---------- 智能能力（P3） ----------
# 召回规模与融合
QA_TOP_K_VECTOR=20
QA_TOP_K_FTS=20
QA_FUSE_KEEP=25
QA_EVIDENCE_TOP=6
QA_RRF_K=60
# 可答门槛：重排可用时卡 top1 重排分；重排不可用时卡余弦相似度或命中词数
QA_MIN_RERANK_SCORE=0.35
QA_MIN_VECTOR_SIM=0.58
QA_MIN_FTS_OVERLAP=2
# 生成与校验
QA_MAX_EVIDENCE_CHARS=6000
QA_ANSWER_MAX_TOKENS=900
QA_ANSWER_TEMPERATURE=0.2
QA_HISTORY_TURNS=3
QA_MAX_QUESTION_CHARS=200
QA_MIN_CITATION_COVERAGE=0.6
QA_REPAIR_MAX=1

# ---------- 会话与编排（P4） ----------
# Redis 上下文窗口存活秒数；PG 里的消息留痕不受此限制
ORC_SESSION_TTL=1800
# 进指代还原的历史轮数（问 + 答各算一条消息）
ORC_HISTORY_TURNS=6
# 一轮最多并行几个子问题
ORC_FANOUT_MAX=3
# 单段作答总超时（秒），超时该段走兜底话术，不影响其他段
ORC_SEGMENT_TIMEOUT=25
# SSE 心跳间隔（秒），挡住 Nginx 的 60s 空闲断开
ORC_HEARTBEAT=15
