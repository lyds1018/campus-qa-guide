# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=true
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ---- PostgreSQL ----
POSTGRES_DB=campus_qa
POSTGRES_USER=qa
POSTGRES_PASSWORD=change-me-strong-password
DB_HOST=127.0.0.1
DB_PORT=5432

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- MinIO ----
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=qa
MINIO_ROOT_PASSWORD=change-me-min-12-chars
MINIO_BUCKET=campus-qa
# 首次拉取镜像后把实际版本写死在这里，避免 latest 漂移
MINIO_TAG=RELEASE.2024-12-18T13-15-44Z

# ---- 前端 ----
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- 知识入库（P1）----
# 向量维度在建表时决定，换嵌入模型需迁移重建列与索引
EMBEDDING_DIM=1024
CHUNK_SIZE=500
CHUNK_OVERLAP=80
INGEST_QUEUE=queue:ingest
WORKER_STALE_MINUTES=30
